<Page x:Class="DesktopApp.Pages.SpecificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DesktopApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SpecificationsPage">

    <Grid x:Name="Specifikacije" Grid.Column="1" Grid.Row="1" Background="{StaticResource HeaderLinksBg}" Loaded="Specifikacije_Loaded">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"></ColumnDefinition>
            <ColumnDefinition Width="300"></ColumnDefinition>
            <ColumnDefinition Width="300"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        
        <Label Content="Kategorija" Style="{StaticResource TextBoxLabel}" Grid.Column="0" Grid.Row="0"/>
        <ComboBox x:Name="categoryComboBox" Grid.Column="1" Grid.Row="0" Style="{StaticResource ComboBox}" SelectionChanged="categoryComboBox_SelectionChanged"/>

        <Label Content="Specifikacija" Style="{StaticResource TextBoxLabel}" Grid.Column="0" Grid.Row="1" />
        <TextBox Style="{StaticResource TextBox}" Grid.Row="1" Grid.Column="1" x:Name="specificationNameTextBox"/>

        <Button Style="{StaticResource Btn}" Content="Dodaj specifikaciju" Grid.Column="3" Grid.Row="0" x:Name="addSpecificationBtn"/>
        <Button Style="{StaticResource Btn}" Content="Ažuriraj specifikaciju" Grid.Column="3" Grid.Row="1" x:Name="updateSpecificationBtn"/>
        <Button Style="{StaticResource Btn}" Content="Obriši specifikaciju" Grid.Column="3" Grid.Row="2" x:Name="deleteSpecificationBtn"/>

        <DataGrid Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="3" AutoGenerateColumns="False" x:Name="CategorySpecificationsTable" SelectionUnit="FullRow" IsReadOnly="True" SelectionMode="Single" HorizontalAlignment="Stretch" SelectionChanged="CategorySpecificationsTable_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID Specifikacije" Binding="{Binding category_specification_id}"></DataGridTextColumn>
                <DataGridTextColumn Header="Specifikacija" Binding="{Binding name}"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
